# Supabase — obtener en https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para scripts de administración / seed (NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dominio interno sintético para el login username -> email (no visible al usuario)
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=bimetriks.local
